# ============================================
# Kokpit Docker Environment Configuration
# ============================================
# Copy this file to .env for docker-compose
# NEVER commit .env to version control

# ============================================
# Environment
# ============================================
NODE_ENV=development

# ============================================
# Service Ports
# ============================================
API_PORT=3001
WEB_PORT=3000
MYSQL_PORT=3306
REDIS_PORT=6379

# ============================================
# MySQL Configuration
# ============================================
MYSQL_ROOT_PASSWORD=kokpit_root_secret_change_me
MYSQL_DATABASE=kokpit
MYSQL_USER=kokpit
MYSQL_PASSWORD=kokpit_secret_change_me

# ============================================
# Redis Configuration
# ============================================
# Required for production (docker-compose.prod.yml)
REDIS_PASSWORD=redis_secret_change_me

# ============================================
# JWT Configuration
# ============================================
# IMPORTANT: Generate secure secrets for production
# Use: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
# Frontend Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=http://localhost:3001

# ============================================
# Platform API Keys (Production)
# ============================================
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
TRENDYOL_SUPPLIER_ID=

GETIR_API_KEY=
GETIR_API_SECRET=

YEMEKSEPETI_API_KEY=
YEMEKSEPETI_API_SECRET=

MIGROS_API_KEY=
MIGROS_API_SECRET=

# ============================================
# Firebase (Push Notifications)
# ============================================
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
