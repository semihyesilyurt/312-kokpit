# ============================================
# Kokpit API Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=3001

# ============================================
# Database (MySQL)
# ============================================
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://kokpit:kokpit_secret@localhost:3306/kokpit

# ============================================
# Redis (Cache & Queue)
# ============================================
# Format: redis://[:password]@host:port
REDIS_URL=redis://localhost:6379

# ============================================
# JWT Authentication
# ============================================
# IMPORTANT: Generate secure secrets for production
# Use: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list for multiple origins
CORS_ORIGIN=http://localhost:3000

# ============================================
# Trendyol Yemek API
# ============================================
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
TRENDYOL_SUPPLIER_ID=
TRENDYOL_BASE_URL=https://api.trendyol.com

# ============================================
# Getir Yemek API
# ============================================
GETIR_API_KEY=
GETIR_API_SECRET=
GETIR_BASE_URL=https://api.getir.com

# ============================================
# Yemeksepeti API
# ============================================
YEMEKSEPETI_API_KEY=
YEMEKSEPETI_API_SECRET=
YEMEKSEPETI_BASE_URL=https://api.yemeksepeti.com

# ============================================
# Migros Yemek API
# ============================================
MIGROS_API_KEY=
MIGROS_API_SECRET=
MIGROS_BASE_URL=https://api.migros.com.tr

# ============================================
# Firebase (Push Notifications)
# ============================================
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ============================================
# File Upload
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug

# ============================================
# Rate Limiting
# ============================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100
