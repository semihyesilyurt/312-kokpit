# ============================================
# Kokpit Web Environment Configuration
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ============================================
# API Configuration
# ============================================
# Backend API URL (without trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# WebSocket URL for real-time updates
NEXT_PUBLIC_WS_URL=http://localhost:3001

# ============================================
# Application Settings
# ============================================
# Application name displayed in UI
NEXT_PUBLIC_APP_NAME=Kokpit

# Default locale (tr, en)
NEXT_PUBLIC_DEFAULT_LOCALE=tr

# ============================================
# Feature Flags
# ============================================
# Enable/disable features
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# ============================================
# Map Configuration
# ============================================
# Leaflet map default center (Istanbul)
NEXT_PUBLIC_MAP_DEFAULT_LAT=41.0082
NEXT_PUBLIC_MAP_DEFAULT_LNG=28.9784
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12

# ============================================
# Production Only
# ============================================
# Sentry DSN for error tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN=

# Google Analytics ID (optional)
# NEXT_PUBLIC_GA_ID=
